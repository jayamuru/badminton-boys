# ---------------------------------------------------------------------------
# Badminton Boys — backend configuration
#
# Copy this file to `.env.local` and fill in the two values from your Supabase
# project (Project Settings → API). With both set, the app runs in cloud mode:
# real accounts, one shared database, live scores across everyone's phones.
#
# Leave them blank (or delete the file) and the app runs entirely on-device
# with the simulated demo season — handy for development and screenshots.
#
# Both values are safe to ship in the client bundle. The anon key is public by
# design; row-level security in supabase/schema.sql is what protects the data.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional, but required for "Share live match" to work from the Android app.
#
# The public web address of the deployed site. The packaged app is served from
# https://localhost, so without this it would mint QR codes pointing at the
# scanner's own phone. Set it and share links point at the real site instead.
VITE_PUBLIC_URL=https://badminton-boys.vercel.app
